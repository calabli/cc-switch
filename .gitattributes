# Auto detect text files and perform LF normalization
* text=auto

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout.
*.rs text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf

# TypeScript/JavaScript files
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf

# HTML/CSS files
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf

# SVG 图标：同样要钉死 eol=lf。漏掉的话 Windows runner 检出成 CRLF、macOS/Linux
# 检出成 LF，文件内容不同 → vite 的内容哈希不同 → 同一份源码在两个平台产出的
# 资源文件名对不上（连带引用它们的 JS chunk 也跟着变）。
*.svg text eol=lf

# Shell scripts
*.sh text eol=lf

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.exe binary
*.dll binary